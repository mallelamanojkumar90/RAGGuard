# RAGGuard Environment Configuration

# Application
PROJECT_NAME=RAGGuard
ENVIRONMENT=development
API_V1_PREFIX=/api
DEBUG=true

# Server Settings
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# LLM Provider Configuration (options: ollama, openai, gemini, openrouter)
LLM_PROVIDER=ollama
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Vector Database (options: chroma, qdrant)
VECTOR_DB=chroma
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Evaluation & Guardrail
MAX_RETRIES=2
TOP_K=5

# Jev Configuration (will be refined in Phase 4 upon SDK inspection)
JEV_API_KEY=
JEV_BASE_URL=
